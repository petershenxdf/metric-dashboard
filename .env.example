# Copy to .env and add a DeepSeek API key for generated explanations.
# Deterministic recommendations and labeling remain available without this key.
METRIC_DASHBOARD_DEEPSEEK_BASE_URL=https://api.deepseek.com
METRIC_DASHBOARD_DEEPSEEK_API_KEY=
METRIC_DASHBOARD_ACTIVE_LEARNING_DB_PATH=runtime_data/active_learning/active_learning.sqlite3
METRIC_DASHBOARD_LLM_TIMEOUT_SECONDS=60
