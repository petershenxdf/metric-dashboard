# Copy to .env and edit these values for your Step 8.5 runtime.
# Supported providers: deepseek, ollama, mock.
METRIC_DASHBOARD_LLM_PROVIDER=deepseek
METRIC_DASHBOARD_LLM_MODEL=deepseek-v4-pro
METRIC_DASHBOARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
METRIC_DASHBOARD_DEEPSEEK_BASE_URL=https://api.deepseek.com
METRIC_DASHBOARD_DEEPSEEK_API_KEY=
METRIC_DASHBOARD_OLLAMA_KEEP_ALIVE=30m
METRIC_DASHBOARD_LLM_TEMPERATURE=0.1
METRIC_DASHBOARD_LLM_TIMEOUT_SECONDS=60
METRIC_DASHBOARD_LLM_MAX_OUTPUT_TOKENS=800
METRIC_DASHBOARD_LLM_ALLOW_MOCK_FALLBACK=true
