# Copy to .env and edit these values for your local Ollama runtime.
METRIC_DASHBOARD_LLM_PROVIDER=ollama
METRIC_DASHBOARD_LLM_MODEL=qwen2.5:14b
METRIC_DASHBOARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
METRIC_DASHBOARD_OLLAMA_KEEP_ALIVE=30m
METRIC_DASHBOARD_LLM_TEMPERATURE=0.1
METRIC_DASHBOARD_LLM_TIMEOUT_SECONDS=45
METRIC_DASHBOARD_LLM_MAX_OUTPUT_TOKENS=800
METRIC_DASHBOARD_LLM_ALLOW_MOCK_FALLBACK=true
